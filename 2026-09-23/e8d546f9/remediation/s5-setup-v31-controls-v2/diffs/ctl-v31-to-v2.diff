 timeout 10 cat "$FIFO" > "$EXD/P2.holder-update-attempt.txt" 2>/dev/null; log "P2 fifo read rc=$? content=[$(head -c 160 "$EXD/P2.holder-update-attempt.txt" 2>/dev/null)]"
