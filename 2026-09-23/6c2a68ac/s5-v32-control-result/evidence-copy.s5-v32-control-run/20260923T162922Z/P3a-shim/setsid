#!/usr/bin/env bash
# P3a control shim: seen ONLY by the launcher process via PATH. Does NOT create a session: execs argv unchanged, so the primitive's own_confirm sees the gate in the launcher's own process group (decoy) and refuses adoption.
case "${1:-}" in --version) echo "setsid SHIM-P3a (control fault: no new session; argv exec unchanged)"; exit 0;; esac; exec "$@"
