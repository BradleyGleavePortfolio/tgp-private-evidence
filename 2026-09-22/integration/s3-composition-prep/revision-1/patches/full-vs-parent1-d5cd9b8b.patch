+{
+  "note": "Hostile vectors for the R75 / R100.A2 gate. Every banned literal lives HERE, as JSON data, because .json is not an executable extension in .github/r75-policy.json — so the regression suite can exercise real banned tokens without becoming a violation itself. Fixture DATA only: the executable spec that reads this file IS scanned, as is every other test source. Cases without a legacyExit are ones whose pre-repair behaviour has not been executed, so no expectation is stated for them rather than a guessed one.",
+  "policyExpectations": {
+    "suppressionToken": "@ts-expect-error",
+    "emptyCatchClasses": ["empty-catch-null", "empty-catch-undefined", "empty-catch-block"],
+    "note": "Policy-shape expectations the spec asserts. The suppression token name lives here because naming it in executable test source would itself be an R75 violation."
+  },
+  "legacyAlgorithm": {
+    "note": "The deleted pre-repair CI shell implementation, reproduced so cases can prove sensitivity to the defect being repaired. literalTokens are counted with grep -cF semantics (matching LINES, not occurrences); all counts are summed into ONE aggregate net; any line matching exemptLinePattern is discarded whole; excludeSuffixes drop test and spec sources entirely.",
+    "literalTokens": [
+      "@ts-ignore",
+      "@ts-expect-error",
+      "as any",
+      "as unknown as",
+      "as never",
+      ".catch(()=>undefined)",
+      ".catch(()=>null)",
+      ".catch(()=>{})",
+      "Coming soon",
+      "lorem ipsum",
+      "foo@bar",
+      "John Doe"
+    ],
+    "emptyCatchLiterals": [".catch(()=>undefined)", ".catch(()=>null)", ".catch(()=>{})"],
+    "emptyCatchPattern": "\\.catch\\(\\s*[^)]*\\s*=>\\s*(undefined|null|\\{\\s*\\})\\s*\\)",
+    "exemptLinePattern": "@ts-expect-error.*#[0-9]{4,}",
+    "excludeSuffixes": [".spec.ts", ".spec.js", ".test.ts", ".test.js", ".d.ts"],
+    "includeRoots": ["src/", "scripts/", "test/"]
+  },
+  "cases": [
+    {
+      "name": "same-token net-zero: an existing banned cast is only relocated",
+      "mode": "range",
+      "base": {
+        "src/a.ts": ["const a = x as any;", "const b = 2;"]
+      },
+      "head": {
+        "src/a.ts": ["const b = 2;", "const a = x as any;"]
+      },
+      "expectExit": 0,
+      "expectNet": {
+        "as any": 0
+      },
+      "legacyExit": 0,
+      "why": "R75 bans net ADDITIONS; a pure move must pass or the gate blocks harmless refactors."
+    },
+    {
+      "name": "cross-token substitution: delete one banned token, introduce a different one",
+      "mode": "range",
+      "base": {
