+    {
+      "name": "every spelling of the swallowed-error catch is detected in its own class",
+      "mode": "range",
+      "base": {},
+      "head": {
+        "src/a.ts": [
+          "p.catch(()=>null);",
+          "p.catch(() => null);",
+          "p.catch(() => {});",
