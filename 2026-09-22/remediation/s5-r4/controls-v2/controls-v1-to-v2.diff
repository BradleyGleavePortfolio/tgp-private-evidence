-# The runner leaves its mktemp scratch dirs (/tmp/s5-genctl-*) as evidence; the control removes only those it caused.
-for d in /tmp/s5-genctl-*; do [ -d "$d" ] && [ "$(stat -c %Y "$d")" -ge "$(stat -c %Y "$CR")" ] && rm -rf "$d"; done
