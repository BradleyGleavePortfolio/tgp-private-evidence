 #!/usr/bin/env bash
+# S2-SETUP-FIXTURE-PREP copy (2026-09-22) of setup-and-runner-readiness/launch-detached.sh sha256 64302b3e77de039a8c74f601227cf431d655f8e1251d5489febb4fb72db0a36d.
