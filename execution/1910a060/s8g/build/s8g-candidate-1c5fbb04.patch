+      // Emulate Nest's public boundary for unexpected DB failures.
+      message: typeof e.getStatus === 'function' ? e.message : 'Internal server error',
+      response: typeof e.getResponse === 'function' ? e.getResponse() : undefined,
+      code: e.code,
