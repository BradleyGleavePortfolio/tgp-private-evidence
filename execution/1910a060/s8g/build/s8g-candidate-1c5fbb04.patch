+                await barrier('before-ledger');
+                return model.upsert(...args);
+              };
+            return typeof model[method] === 'function' ? model[method].bind(model) : model[method];
+          },
+        });
+      }
+      return typeof object[key] === 'function' ? object[key].bind(object) : object[key];
+    },
+  });
+}
+
