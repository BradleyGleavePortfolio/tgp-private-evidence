+  const service = new URL(withFixturePassword(target.prismaUrl, password, G2_S8G_RUNTIME_ROLE));
+  service.searchParams.set('application_name', name);
+  const config = {
+    root,
+    client: resolve(root, 'node_modules/.prisma/client'),
+    head: candidateHead,
+    url: service.toString(),
+    coach: 'coach',
+    intent: 'intent',
+    action: 'status',
+    family: 'workouts',
+    ...options,
+  };
