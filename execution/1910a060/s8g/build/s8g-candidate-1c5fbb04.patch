+    expect(terminalCall(d)?.slice(1)).toEqual(
+      expect.arrayContaining(['partial', 'partial', 'reconciliation_not_performed', COACH, INTENT, 1]),
+    );
+    expect(d.capture).toHaveBeenCalledWith(
