+    );
+    expect(withFixturePassword(base, 'local_fixture', 'service_role')).toBe(
+      'postgresql://service_role:local_fixture@127.0.0.1:55481/g2_nq1_disposable',
+    );
+    expect(withFixturePassword(base, 'local_fixture', 'postgres')).toBe(
