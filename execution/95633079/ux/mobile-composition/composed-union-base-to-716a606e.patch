+it('does not call the native-only focus API on web', async () => {
+  jest.replaceProperty(Native.Platform, 'OS', 'web');
+  const handle = jest.spyOn(Native, 'findNodeHandle').mockImplementation(() => { throw new Error('native-only API'); });
