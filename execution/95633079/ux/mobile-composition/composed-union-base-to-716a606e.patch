+import { darkTokens, lightTokens } from '../../../../theme/tokens';
+const guards = require('./sideEffectGuards.cjs');
+const Native = require('react-native') as typeof import('react-native');
+
+beforeEach(() => guards.installGuards());
+afterEach(async () => {
+  await cleanup();
