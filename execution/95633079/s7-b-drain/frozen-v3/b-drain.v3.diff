+    `${base}?schema=public&schema=public`,
+    `${base}#fragment`,
+  ])('refuses unsafe or ambiguous target %s', (url) => {
+    expect(() => g2BDrainTestTarget(url, ack)).toThrow();
+  });
+  it('refuses absent, mistaken or port-mismatched confirmation', () => {
