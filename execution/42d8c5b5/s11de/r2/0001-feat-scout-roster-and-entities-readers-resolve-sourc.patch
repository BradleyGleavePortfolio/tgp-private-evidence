+      if (!tokens.includes(ET) && Object.prototype.hasOwnProperty.call(mapper.spec.families, ET))
+        tokens.push(ET);
+      if (tokens.length >= 2) return { platform: mapper.sourcePlatform, tokens: tokens.sort() };
+    }
