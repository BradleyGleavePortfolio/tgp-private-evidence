+function segments(queries: string[]): string[][] {
+  const out: string[][] = [];
+  let cur: string[] | null = null;
+  for (const q of queries) {
+    if (q === '-- tx:begin') cur = [];
+    else if (q === '-- tx:commit' || q === '-- tx:rollback') {
+      if (cur) out.push(cur);
+      cur = null;
+    } else if (cur && !isNoise(q)) cur.push(q);
+  }
+  return out;
+}
