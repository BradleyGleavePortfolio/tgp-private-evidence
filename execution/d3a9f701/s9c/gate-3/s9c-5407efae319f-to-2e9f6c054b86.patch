+  'already_present_verified',
+  'created_native',
+  'family',
+  'ledger',
+  'observed_unique',
+  'rejected',
+  'staged_unique',
+  'unresolved',
+];
+/** The six additive S9-C keys (D-S9-5, doc §3 R15). */
