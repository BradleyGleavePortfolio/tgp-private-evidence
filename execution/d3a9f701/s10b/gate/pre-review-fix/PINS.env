HARNESS_BASE_HEAD=a4af8e330bd4d6f882f0aebd411200b76d651aba   # BASE_HEAD literal in test/utils/g2-s10b-{bootstrap.sh,db.ts} (ancestor of BASE; the prisma diff from it is still exactly the S10-B three)
