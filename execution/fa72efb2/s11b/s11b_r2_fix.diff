+    const rawFailure = (meta: Record<string, unknown> | undefined) =>
+      new PrismaClientKnownRequestError(
+        `Raw query failed. Code: \`${String(meta?.code)}\`. Message: \`${String(meta?.message)}\``,
+        { code: 'P2010', clientVersion: '6.19.3', meta },
