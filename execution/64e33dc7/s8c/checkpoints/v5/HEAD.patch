   NATIVE_KIND,
   PROVENANCE_OUTCOME,
   childSourceIdPrefix,
@@ -116,7 +117,7 @@ export async function countUnresolvedChildren(tx: Tx, parent: ProvenanceKey): Pr
     where: {
       coach_id: parent.coachId,
